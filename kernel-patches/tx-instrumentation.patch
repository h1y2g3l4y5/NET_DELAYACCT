From 053b0fd8ba718bcb88c4c17355a2c4e2b6129b7b Mon Sep 17 00:00:00 2001
From: laiguo-liang <2909269677@qq.com>
Date: Mon, 27 Jul 2026 20:35:31 +0800
Subject: [PATCH 2/2] net-delayacct: add TX path instrumentation

Stamp skb->delayacct_start on outgoing sk_buffs and accumulate
per-socket TX latency in dev_hard_start_xmit() before the driver
xmit callback.

TX timestamp is set in:
- __tcp_transmit_skb() clone block: covers all clone_it=1 paths
  (first transmission via tcp_write_xmit, normal retransmit,
  SYN/SYNACK, Fast Open, SYN-cookie ACK, repair mode, MTU probe).
- __tcp_retransmit_skb() pskb_copy path: covers clone_it=0
  retransmit when skb data is unaligned or headroom is too large.
- udp_sendmsg()/udpv6_sendmsg() fast path: after ip_make_skb()/
  ip6_make_skb() returns, before udp_send_skb().
- udp_push_pending_frames()/udp_v6_push_pending_frames(): covers
  all UDP corked flush paths (do_append_data, splice_eof,
  setsockopt(UDP_CORK=0)).

Control packets (pure ACK, RST, zero-window probe) use alloc_skb
which zero-initializes delayacct_start; tx_end guards against
start==0 so they are not counted.

Known limitations (design trade-offs, see v3.0.0 review ISSUE-8):
- GSO: a large GSO skb is segmented in dev_hard_start_xmit, each
  segment calls tx_end once, so tx_count is inflated by N. The
  delayacct_start is propagated via __copy_skb_header, so per-segment
  latency values remain accurate.

Includes fixes for:
- BUG-1: IPv6 UDP TX instrumentation
- BUG-2: UDP corked path (MSG_MORE/UDP_CORK) TX instrumentation
- BUG-7: TCP retransmit clone resets delayacct_start (clone + pskb_copy)
- NEW-BUG-8: Removed dead tx_start in tcp_sendmsg_locked

GSO timestamp inheritance is handled automatically by
__copy_skb_header() because delayacct_start lives inside the
sk_buff headers struct_group (see skbuff_h-modification.patch).

Apply after the rx-instrumentation patch.

Signed-off-by: laiguo-liang <2909269677@qq.com>
---
 net/core/dev.c        |  1 +
 net/ipv4/tcp_output.c | 13 +++++++++++++
 net/ipv4/udp.c        |  6 +++++-
 net/ipv6/udp.c        |  7 ++++++-
 4 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/net/core/dev.c b/net/core/dev.c
index 0d8072c13..a5d0f9cd9 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -3590,6 +3590,7 @@ struct sk_buff *dev_hard_start_xmit(struct sk_buff *first, struct net_device *de
 		struct sk_buff *next = skb->next;

 		skb_mark_not_on_list(skb);
+		net_delayacct_tx_end(skb->sk, skb);
 		rc = xmit_one(skb, dev, txq, next != NULL);
 		if (unlikely(!dev_xmit_complete(rc))) {
 			skb->next = next;
diff --git a/net/ipv4/tcp_output.c b/net/ipv4/tcp_output.c
index 5631041ae..b3d670ad9 100644
--- a/net/ipv4/tcp_output.c
+++ b/net/ipv4/tcp_output.c
@@ -39,6 +39,7 @@

 #include <net/tcp.h>
 #include <net/mptcp.h>
+#include <net/net-delayacct.h>

 #include <linux/compiler.h>
 #include <linux/gfp.h>
@@ -1276,6 +1277,13 @@ static int __tcp_transmit_skb(struct sock *sk, struct sk_buff *skb,
 		 * because skb->dev is aliased with skb->rbnode.rb_left
 		 */
 		skb->dev = NULL;
+		/* Reset the TX timestamp on the clone so retransmissions
+		 * are measured from this clone's creation, not from the
+		 * original sendmsg time (BUG-7 fix). This also makes the
+		 * first-time transmission measure "clone to driver" latency,
+		 * consistently reflecting stack processing delay.
+		 */
+		net_delayacct_tx_start(sk, skb);
 	}

 	inet = inet_sk(sk);
@@ -3343,6 +3351,11 @@ int __tcp_retransmit_skb(struct sock *sk, struct sk_buff *skb, int segs)
 			nskb = __pskb_copy(skb, MAX_TCP_HEADER, GFP_ATOMIC);
 			if (nskb) {
 				nskb->dev = NULL;
+				/* Reset TX timestamp for pskb_copy retransmit path
+				 * (clone_it=0, so __tcp_transmit_skb's clone block
+				 * is skipped). BUG-7 residual fix.
+				 */
+				net_delayacct_tx_start(sk, nskb);
 				err = tcp_transmit_skb(sk, nskb, 0, GFP_ATOMIC);
 			} else {
 				err = -ENOBUFS;
diff --git a/net/ipv4/udp.c b/net/ipv4/udp.c
index 6a04701ee..4f294cd8a 100644
--- a/net/ipv4/udp.c
+++ b/net/ipv4/udp.c
@@ -1009,6 +1009,8 @@ int udp_push_pending_frames(struct sock *sk)
 	if (!skb)
 		goto out;

+	/* TX latency for corked path (MSG_MORE / UDP_CORK) — BUG-2 fix */
+	net_delayacct_tx_start(sk, skb);
 	err = udp_send_skb(skb, fl4, &inet->cork.base);

 out:
@@ -1265,8 +1267,10 @@ int udp_sendmsg(struct sock *sk, struct msghdr *msg, size_t len)
 				  sizeof(struct udphdr), &ipc, &rt,
 				  &cork, msg->msg_flags);
 		err = PTR_ERR(skb);
-		if (!IS_ERR_OR_NULL(skb))
+		if (!IS_ERR_OR_NULL(skb)) {
+			net_delayacct_tx_start(sk, skb);
 			err = udp_send_skb(skb, fl4, &cork);
+		}
 		goto out;
 	}

diff --git a/net/ipv6/udp.c b/net/ipv6/udp.c
index 325f7a63c..725729aa2 100644
--- a/net/ipv6/udp.c
+++ b/net/ipv6/udp.c
@@ -1329,6 +1329,8 @@ static int udp_v6_push_pending_frames(struct sock *sk)
 	if (!skb)
 		goto out;

+	/* TX latency for corked path (MSG_MORE / UDP_CORK) — BUG-2 fix */
+	net_delayacct_tx_start(sk, skb);
 	err = udp_v6_send_skb(skb, &inet_sk(sk)->cork.fl.u.ip6,
 			      &inet_sk(sk)->cork.base);
 out:
@@ -1597,8 +1599,11 @@ int udpv6_sendmsg(struct sock *sk, struct msghdr *msg, size_t len)
 				   (struct rt6_info *)dst,
 				   msg->msg_flags, &cork);
 		err = PTR_ERR(skb);
-		if (!IS_ERR_OR_NULL(skb))
+		if (!IS_ERR_OR_NULL(skb)) {
+			/* TX latency for non-corked fast path — BUG-1 fix */
+			net_delayacct_tx_start(sk, skb);
 			err = udp_v6_send_skb(skb, fl6, &cork.base);
+		}
 		/* ip6_make_skb steals dst reference */
 		goto out_no_dst;
 	}
--
