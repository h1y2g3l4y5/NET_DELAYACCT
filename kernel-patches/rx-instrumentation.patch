From 2d8e3ee5ee2d59fd264195fb43939d8ff61d96c2 Mon Sep 17 00:00:00 2001
From: laiguo-liang <2909269677@qq.com>
Date: Mon, 27 Jul 2026 20:35:30 +0800
Subject: [PATCH 1/2] net-delayacct: add RX path instrumentation

Stamp skb->delayacct_start at __netif_receive_skb_core() entry
and accumulate per-socket RX latency in tcp_recvmsg()/udp_recvmsg()
when the payload is delivered to user space.

Note on rx_end placement:
- TCP: rx_end is recorded at skb dequeue time (found_ok_skb), i.e. when
  the skb is selected for delivery to user space. Checksum was already
  validated on the RX input path before the skb was enqueued.
- UDP: rx_end is recorded after checksum validation AND successful copy
  to user space, so corrupted packets are not counted. Guarded by
  !peeking to prevent MSG_PEEK from consuming the timestamp.

Known limitations (design trade-offs, see v3.0.0 review ISSUE-8/9/10):
- GRO: rx_start is stamped after GRO merge, so only the last fragment's
  arrival time is captured for a merged skb.
- rx_start is taken inside __netif_receive_skb_core (after NAPI poll,
  RCU locked); it measures intra-stack processing time, not driver
  poll latency.

Includes fixes for:
- BUG-1: IPv6 UDP RX instrumentation
- BUG-3: MSG_PEEK does not consume timestamp
- BUG-4: UDP rx_end after checksum validation AND successful copy
- BUG-5: TCP splice RX instrumentation
- BUG-6: TCP zerocopy RX instrumentation

Apply after the sock_h and skbuff_h patches.

Signed-off-by: laiguo-liang <2909269677@qq.com>
---
 net/core/dev.c | 3 +++
 net/ipv4/tcp.c | 5 +++++
 net/ipv4/udp.c | 8 ++++++++
 net/ipv6/udp.c | 7 +++++++
 4 files changed, 23 insertions(+)

diff --git a/net/core/dev.c b/net/core/dev.c
index 5a5bd339f..0d8072c13 100644
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -101,6 +101,7 @@
 #include <linux/stat.h>
 #include <net/dsa.h>
 #include <net/dst.h>
+#include <net/net-delayacct.h>
 #include <net/dst_metadata.h>
 #include <net/gro.h>
 #include <net/pkt_sched.h>
@@ -5355,6 +5356,8 @@ static int __netif_receive_skb_core(struct sk_buff **pskb, bool pfmemalloc,

 	trace_netif_receive_skb(skb);

+	net_delayacct_rx_start(skb);
+
 	orig_dev = skb->dev;

 	skb_reset_network_header(skb);
diff --git a/net/ipv4/tcp.c b/net/ipv4/tcp.c
index 2df05ea2e..f8ae2a71e 100644
--- a/net/ipv4/tcp.c
+++ b/net/ipv4/tcp.c
@@ -271,6 +271,7 @@
 #include <net/icmp.h>
 #include <net/inet_common.h>
 #include <net/tcp.h>
+#include <net/net-delayacct.h>
 #include <net/mptcp.h>
 #include <net/xfrm.h>
 #include <net/ip.h>
@@ -1578,6 +1579,7 @@ int tcp_read_sock(struct sock *sk, read_descriptor_t *desc,
 				if (!len)
 					break;
 			}
+			net_delayacct_rx_end(sk, skb);
 			used = recv_actor(desc, skb, offset, len);
 			if (used <= 0) {
 				if (!copied)
@@ -2153,6 +2155,7 @@ static int tcp_zerocopy_receive(struct sock *sk,
 			} else {
 				skb = tcp_recv_skb(sk, seq, &offset);
 			}
+			net_delayacct_rx_end(sk, skb);

 			if (TCP_SKB_CB(skb)->has_rxtstamp) {
 				tcp_update_recv_tstamps(skb, tss);
@@ -2478,6 +2481,8 @@ static int tcp_recvmsg_locked(struct sock *sk, struct msghdr *msg, size_t len,

 found_ok_skb:
 		/* Ok so how much can we use? */
+		if (!(flags & MSG_PEEK))
+			net_delayacct_rx_end(sk, skb);
 		used = skb->len - offset;
 		if (len < used)
 			used = len;
diff --git a/net/ipv4/udp.c b/net/ipv4/udp.c
index 16ca211c8..6a04701ee 100644
--- a/net/ipv4/udp.c
+++ b/net/ipv4/udp.c
@@ -105,6 +105,7 @@
 #include <net/checksum.h>
 #include <net/gso.h>
 #include <net/xfrm.h>
+#include <net/net-delayacct.h>
 #include <trace/events/udp.h>
 #include <linux/static_key.h>
 #include <linux/btf_ids.h>
@@ -1872,6 +1873,13 @@ int udp_recvmsg(struct sock *sk, struct msghdr *msg, size_t len, int flags,
 		return err;
 	}

+	/* Record RX latency only after checksum validation AND successful
+	 * copy to user (BUG-4 complete fix). Skip MSG_PEEK so the timestamp
+	 * is preserved for the real recv (BUG-3).
+	 */
+	if (!peeking)
+		net_delayacct_rx_end(sk, skb);
+
 	if (!peeking)
 		UDP_INC_STATS(sock_net(sk),
 			      UDP_MIB_INDATAGRAMS, is_udplite);
diff --git a/net/ipv6/udp.c b/net/ipv6/udp.c
index c77ee9a3c..325f7a63c 100644
--- a/net/ipv6/udp.c
+++ b/net/ipv6/udp.c
@@ -47,6 +47,7 @@
 #include <net/ip6_tunnel.h>
 #include <trace/events/udp.h>
 #include <net/xfrm.h>
+#include <net/net-delayacct.h>
 #include <net/inet_hashtables.h>
 #include <net/inet6_hashtables.h>
 #include <net/busy_poll.h>
@@ -398,6 +399,12 @@ int udpv6_recvmsg(struct sock *sk, struct msghdr *msg, size_t len,
 		kfree_skb(skb);
 		return err;
 	}
+	/* Record RX latency only after checksum validation AND successful
+	 * copy to user (BUG-4 complete fix). Skip MSG_PEEK so the timestamp
+	 * is preserved for the real recv (BUG-3).
+	 */
+	if (!peeking)
+		net_delayacct_rx_end(sk, skb);
 	if (!peeking)
 		SNMP_INC_STATS(mib, UDP_MIB_INDATAGRAMS);

--
